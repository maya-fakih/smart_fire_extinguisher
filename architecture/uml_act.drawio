                <UserObject label="__init__(config: dict, state: SystemState, notifier=None)&lt;br/&gt;start() -&amp;gt; None&lt;br/&gt;stop() -&amp;gt; None&lt;br/&gt;_run_loop() -&amp;gt; None&lt;br/&gt;_tick() -&amp;gt; None&lt;br/&gt;_reconcile_pump(sensor_active, danger, actions, mode) -&amp;gt; None&lt;br/&gt;_handle_new_prediction(pred_id, danger, actions, mode) -&amp;gt; None&lt;br/&gt;_check_copilot_resolution() -&amp;gt; None&lt;br/&gt;_reset_copilot_wait() -&amp;gt; None&lt;br/&gt;_dispatch_manual_commands() -&amp;gt; None&lt;br/&gt;_notify(danger: int, actions: list, context: str) -&amp;gt; None&lt;span&gt;&lt;/span&gt;" link="&lt;span&gt;  __init__(config_path: str,&#xa;&lt;/span&gt;&lt;span&gt;           state: SystemState,&#xa;&lt;/span&gt;&lt;span&gt;           db: ThinkDatabase,&#xa;&lt;/span&gt;&lt;span&gt;           notifier: NotificationService) → None&#xa;&lt;/span&gt;&lt;span&gt;    ← calls ActuatorParser.load()&#xa;&lt;/span&gt;&lt;span&gt;    ← builds initial mode from config default_mode&#xa;&lt;/span&gt;&lt;span&gt;  start() → None&#xa;&lt;/span&gt;&lt;span&gt;    ← starts each actuator as its own Process&#xa;&lt;/span&gt;&lt;span&gt;    ← starts _act_loop&#xa;&lt;/span&gt;&lt;span&gt;  stop() → None&#xa;&lt;/span&gt;&lt;span&gt;    ← stops all processes gracefully&#xa;&lt;/span&gt;&lt;span&gt;  set_mode(mode: ActMode) → None&#xa;&lt;/span&gt;&lt;span&gt;    ← swaps mode at runtime&#xa;&lt;/span&gt;&lt;span&gt;    ← called by SystemOrchestrator from website&#xa;&lt;/span&gt;&lt;span&gt;  _act_loop() → None&#xa;&lt;/span&gt;&lt;span&gt;    ← watches state.danger_level&#xa;&lt;/span&gt;&lt;span&gt;    ← if danger_level &amp;gt;= threshold → calls _mode.run()&#xa;&lt;/span&gt;&lt;span&gt;    ← if danger_level &amp;lt; threshold for clear_delay_s&#xa;&lt;/span&gt;&lt;span&gt;       → deactivates pump + alarm&#xa;&lt;/span&gt;&lt;span&gt;  _should_run() → bool&#xa;&lt;/span&gt;&lt;span&gt;    ← reads state.sensor_triggered&#xa;&lt;/span&gt;&lt;span&gt;    ← returns True if system should be active&#xa;&lt;/span&gt;" id="105">
